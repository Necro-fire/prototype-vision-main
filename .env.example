# Copie este arquivo para .env e preencha. O .env nunca vai para o git.
# Variáveis com o prefixo VITE_ vão para o navegador: só coloque nelas o que pode ser público.

# Supabase (Fase 2). Projeto de desenvolvimento: onstyle-dev
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Endereço público do site, sem barra no fim. Entra nos links dos e-mails e na imagem de
# compartilhamento. Em desenvolvimento: http://localhost:8080
VITE_SITE_URL=http://localhost:8080

# E-mails ao cliente (Fase 4). Só o servidor lê estas variáveis: nunca use o prefixo VITE_ nelas.
# Passo a passo em docs/07-emails.md.
# Supabase > Project Settings > API > service_role. Dá acesso total ao banco: só no .env e nos
# segredos da hospedagem, nunca no código, no chat nem no navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Resend > API Keys.
RESEND_API_KEY=
# Quem aparece como remetente. Antes de ter domínio: ON-STYLE <onboarding@resend.dev>
EMAIL_REMETENTE=
# Senha que o agendador usa para chamar /api/emails/processar. Invente uma longa e aleatória.
CRON_SECRET=
